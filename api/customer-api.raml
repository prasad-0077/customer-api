#%RAML 1.0

title: Customer API
description: Simple Customer Management API
version: v1
baseUri: http://localhost:8081/api/v1

/customers:

  get:
    description: Get all customers
    responses:
      200:
        body:
          application/json:
            example:
              [
                {
                  "id": 101,
                  "name": "John",
                  "email": "john@example.com"
                },
                {
                  "id": 102,
                  "name": "David",
                  "email": "david@example.com"
                }
              ]

  post:
    description: Create a new customer
    body:
      application/json:
        example:
          {
            "id": 103,
            "name": "Prasad",
            "email": "prasad@example.com"
          }

    responses:
      201:
        body:
          application/json:
            example:
              {
                "message": "Customer created successfully"
              }

  /{customerId}:

    get:
      description: Get customer by ID
      responses:
        200:
          body:
            application/json:
              example:
                {
                  "id": 101,
                  "name": "John",
                  "email": "john@example.com"
                }

        404:
          body:
            application/json:
              example:
                {
                  "message": "Customer not found"
                }